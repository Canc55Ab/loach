{
  "name": "55ab-loach",
  "version": "2.0.0",
  "description": "typescript pattern project",
  "main": "dist/index.cjs.cjs",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.cjs.cjs"
    },
    "./package.json": "./package.json",
    "./dist/*": "./dist/*"
  },
  "scripts": {
    "build": "rollup -c rollup.config.ts --configPlugin typescript",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage.enabled --coverage.provider=v8 --coverage.include='src/**/*.ts' --coverage.reporter=text",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "prepublishOnly": "npm run build",
    "publishPatch": "npm login && npm version patch && npm publish",
    "publishMinor": "npm login && npm version minor && npm publish",
    "publishMajor": "npm login && npm version major && npm publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Canc55Ab/loach.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "loach",
    "patterns"
  ],
  "author": "55ab",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.3.1",
    "@vitest/coverage-v8": "^4.1.4",
    "rollup": "^4.46.4",
    "rollup-plugin-delete": "^3.0.1",
    "rollup-plugin-dts": "^6.2.3",
    "tslib": "^2.8.1",
    "typescript": "^5.9.2",
    "vitest": "^4.1.4"
  },
  "dependencies": {
    "55ab-loach": "file:55ab-loach-2.0.0.tgz"
  }
}
